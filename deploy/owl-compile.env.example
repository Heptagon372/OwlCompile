# /etc/owl-compile.env 로 복사해 쓴다. systemd가 읽는 환경 변수 (docs/DEPLOY_AWS.md 6단계)
NODE_ENV=production
# 폰 참가 안내·초대 링크에 쓸 주소. 내 도메인으로 바꾼다
OWL_PUBLIC_URL=https://owl.example.com
# 앞단 Caddy가 붙인 X-Forwarded-* 헤더를 믿는다 (앱이 127.0.0.1에만 열려 있어서 안전)
OWL_TRUST_PROXY=1
# DB 위치. 코드 폴더 밖에 두어 업데이트와 섞이지 않게 한다
OWL_DB_PATH=/var/lib/owl-compile/owl.db
